Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pstrike", "[", 
    RowBox[{"b_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Pstrike", "[", 
     RowBox[{"b", ",", "s"}], "]"}], "=", 
    FractionBox[
     RowBox[{
      RowBox[{"win", "[", 
       RowBox[{"b", ",", 
        RowBox[{"1", "+", "s"}]}], "]"}], "-", 
      RowBox[{"win", "[", 
       RowBox[{
        RowBox[{"1", "+", "b"}], ",", "s"}], "]"}]}], 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "p"}], "+", 
      RowBox[{"win", "[", 
       RowBox[{"b", ",", 
        RowBox[{"1", "+", "s"}]}], "]"}], "+", 
      RowBox[{"p", " ", 
       RowBox[{"win", "[", 
        RowBox[{"b", ",", 
         RowBox[{"1", "+", "s"}]}], "]"}]}], "-", 
